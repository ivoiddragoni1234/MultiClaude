{
  "name": "multiclaude",
  "version": "0.1.0",
  "description": "Run Claude Code across a pool of accounts (subscriptions or API keys) with automatic failover, waiting, shared sessions and persistent memory.",
  "type": "module",
  "bin": {
    "multiclaude": "bin/multiclaude.js"
  },
  "scripts": {
    "start": "node bin/multiclaude.js",
    "web": "node bin/multiclaude.js web",
    "test": "node --test test/*.test.js",
    "build:exe": "node scripts/build-exe.mjs",
    "app": "node bin/multiclaude.js app"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "resedit": "^2.0.3"
  }
}
